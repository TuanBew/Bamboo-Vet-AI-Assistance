# .env.example — commit this file, never commit .env

# ── MCP SERVER ──────────────────────────────────────────────────────────────
# LOCAL DEV value:       http://localhost:3100
# DOCKER PRODUCTION value: http://mcp-server:3100   ← use this in Docker .env
MCP_SERVER_URL=http://localhost:3100

# JWT token for Next.js → MCP server auth
# Generate: cd mcp-server && npm run generate-token
# deploy.ps1 will auto-generate a 365-day token if this is left empty
MCP_JWT_TOKEN=your_mcp_jwt_token_here

MCP_CHAT_ID=your_ragflow_chat_id_here        # same value as RAGFLOW_CHAT_ID below

# ── RAGFLOW ──────────────────────────────────────────────────────────────────
# LOCAL DEV value:       http://127.0.0.1:9380
# DOCKER PRODUCTION value: http://host.docker.internal:9380  ← set in mcp-server/.env
# Keep these if you want to rollback to direct RAGflow (uncomment LEGACY lines in app/api/chat/route.ts)
RAGFLOW_BASE_URL=http://127.0.0.1:9380
RAGFLOW_API_KEY=your_ragflow_api_key_here
RAGFLOW_CHAT_ID=your_chat_assistant_id_here

# ── SUPABASE ──────────────────────────────────────────────────────────────────
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Public keys — safe for browser bundles
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# ── UPSTASH REDIS (rate limiting) ─────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# ── CORPORATE MYSQL (read-only access) ───────────────────────────────────────
MYSQL_HOST=your-mysql-host
MYSQL_PORT=3306
MYSQL_DATABASE=your-database-name
MYSQL_USER=your-mysql-user
MYSQL_PASSWORD=your-mysql-password
MYSQL_SSL=true   # keep true for public IP connections; try false if SSL handshake errors occur

# ── GEMINI API (AI Analysis Board on admin pages) ─────────────────────────────
# Get your key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=<your-gemini-api-key>

# ── DOCKER DEPLOYMENT ────────────────────────────────────────────────────────
# Required when running via docker-compose. Not needed for Vercel or local Next.js dev.

# DuckDNS subdomain — just the name, not the full domain (e.g. bamboo-vet-ai)
# Register at: https://www.duckdns.org
DUCKDNS_SUBDOMAIN=bamboo-vet-ai

# DuckDNS account token — copy from your DuckDNS dashboard
DUCKDNS_TOKEN=<your-duckdns-token>

# Full domain for Caddy HTTPS (must match your DuckDNS subdomain)
DOMAIN=bamboo-vet-ai.duckdns.org

# Email for Let's Encrypt cert expiry notifications
LETSENCRYPT_EMAIL=<your-email@example.com>

# ── PORT OVERRIDES (change only if another service occupies these on the server) ─
# HTTP_PORT=80
# HTTPS_PORT=443
# LOCAL_HTTP_PORT=8080   # used by docker-compose.local.yml for local HTTP testing
