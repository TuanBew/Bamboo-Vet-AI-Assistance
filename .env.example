# .env.example — commit this file

# MCP Server (Phase 2.2 — app routes chat through MCP server instead of RAGflow directly)
# Start the MCP server: cd mcp-server && npm start
# Generate a token:     cd mcp-server && npm run generate-token
MCP_SERVER_URL=http://localhost:3100          # or https://xxx.trycloudflare.com when tunnel active
MCP_JWT_TOKEN=your_mcp_jwt_token_here        # from: cd mcp-server && npm run generate-token
MCP_CHAT_ID=your_ragflow_chat_id_here        # same value as RAGFLOW_CHAT_ID

# RAGflow Configuration — No longer used by the Next.js app (moved to mcp-server/.env)
# Keep these if you want to rollback Phase 2.2 (uncomment LEGACY lines in app/api/chat/route.ts)
RAGFLOW_BASE_URL=http://127.0.0.1:9380
RAGFLOW_API_KEY=your_ragflow_api_key_here
RAGFLOW_CHAT_ID=your_chat_assistant_id_here

# Supabase Configuration
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Supabase Public Keys (safe to expose)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Upstash Redis Configuration
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# Corporate MySQL (read-only access)
MYSQL_HOST=your-mysql-host
MYSQL_PORT=3306
MYSQL_DATABASE=your-database-name
MYSQL_USER=your-mysql-user
MYSQL_PASSWORD=your-mysql-password
MYSQL_SSL=true
