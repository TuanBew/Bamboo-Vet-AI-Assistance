# .env.example — commit this file, never commit .env

# ── SUPABASE ──────────────────────────────────────────────────────────────────
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Public keys — safe for browser bundles
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# ── UPSTASH REDIS (rate limiting) ─────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# ── MYSQL MODE ────────────────────────────────────────────────────────────────
# Vercel production should use the hosted read-only backup database.
# Docker/company-server deployments can use auto/primary/backup depending on access.
MYSQL_MODE=backup

# ── VERCEL PRODUCTION: HOSTED BACKUP MYSQL (read-only) ────────────────────────
# Use these values in Vercel Production env vars. Do not point Vercel at the
# corporate/company MySQL host; Vercel uses dynamic outbound IPs.
BACKUP_MYSQL_HOST=<hosted-mysql-host>
BACKUP_MYSQL_PORT=3306
BACKUP_MYSQL_DATABASE=<hosted-backup-db>
BACKUP_MYSQL_USER=<readonly-user>
BACKUP_MYSQL_PASSWORD=<readonly-password>
BACKUP_MYSQL_SSL=true

# ── LOCAL DOCKER / COMPANY-SERVER MYSQL ───────────────────────────────────────
# Use these for the non-Vercel path where the server/network can reach company
# MySQL directly, or where docker-compose provides a local backup-mysql service.
# MYSQL_MODE=auto
# MYSQL_HOST=your-company-mysql-host
# MYSQL_PORT=3306
# MYSQL_DATABASE=your-company-database-name
# MYSQL_USER=your-readonly-mysql-user
# MYSQL_PASSWORD=your-readonly-mysql-password
# MYSQL_SSL=true
# BACKUP_MYSQL_HOST=backup-mysql
# BACKUP_MYSQL_PORT=3306
# BACKUP_MYSQL_DATABASE=dashboard_bamboovet
# BACKUP_MYSQL_USER=backup_readonly_user
# BACKUP_MYSQL_PASSWORD=backup_readonly_password
# BACKUP_MYSQL_SSL=false

# ── MCP SERVER ────────────────────────────────────────────────────────────────
# Vercel production: use a stable public HTTPS tunnel/domain that reaches the
# local MCP server, which then reaches local RAGflow. Admin/database checks can
# pass independently, but chat streaming needs this endpoint to be reachable.
# Keep `deploy.ps1` on the Docker/company-server path; it still expects the Docker MCP URL.
MCP_SERVER_URL=https://your-stable-mcp-tunnel.example.com

# Local dev value: http://localhost:3100
# Docker/company-server value: http://mcp-server:3100
# MCP_SERVER_URL=http://mcp-server:3100

# JWT token for Next.js → MCP server auth
# Generate: cd mcp-server && npm run generate-token
# deploy.ps1 will auto-generate a 365-day token for Docker/company-server if empty
MCP_JWT_TOKEN=your_mcp_jwt_token_here
MCP_CHAT_ID=your_ragflow_chat_id_here        # same value as RAGFLOW_CHAT_ID below

# ── RAGFLOW ──────────────────────────────────────────────────────────────────
# These live with the MCP server. For Vercel, RAGflow does not need to be public;
# Vercel calls MCP_SERVER_URL over HTTPS, and MCP calls RAGflow locally.
# Local dev value: http://127.0.0.1:9380
# Docker/company-server value: http://host.docker.internal:9380 (in mcp-server/.env)
RAGFLOW_BASE_URL=http://127.0.0.1:9380
RAGFLOW_API_KEY=your_ragflow_api_key_here
RAGFLOW_CHAT_ID=your_chat_assistant_id_here

# ── GEMINI API (AI Analysis Board on admin pages) ─────────────────────────────
# Get your key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=<your-gemini-api-key>

# ── DOCKER DEPLOYMENT (Cloudflare Tunnel) ────────────────────────────────────
# Required when running via docker-compose. Not needed for Vercel or local Next.js dev.

# Cloudflare Tunnel token — replaces Caddy + Let's Encrypt + DuckDNS entirely.
# Obtain from: Cloudflare Zero Trust dashboard → Networks → Tunnels → Create a tunnel → copy the token
# The token encodes which tunnel to run AND where to route traffic (configured in the dashboard).
# DO NOT commit this token — treat it as a secret equivalent to a private key.
CLOUDFLARE_TUNNEL_TOKEN=<your-cloudflare-tunnel-token>

# The public domain configured in the Cloudflare tunnel dashboard
# Used for app-side URL building, OAuth redirect URIs, and production smoke tests.
PRODUCTION_DOMAIN=app.bamboovet.com.vn
